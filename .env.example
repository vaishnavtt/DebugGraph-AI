# ==============================================================================
# DebugGraph AI - Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application Settings
APP_ENV=development
APP_NAME=DebugGraph AI
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM / Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_REASONING_MODEL=gemini-1.5-pro

# Embedding & Cross-Encoder Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=cpu

# PostgreSQL Database Configuration
POSTGRES_USER=debuggraph
POSTGRES_PASSWORD=debuggraph_password
POSTGRES_DB=debuggraph_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://debuggraph:debuggraph_password@localhost:5432/debuggraph_db

# Neo4j Knowledge Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=debuggraph_neo4j_password
NEO4J_DATABASE=neo4j

# GitHub Repository & Commit Intelligence
GITHUB_TOKEN=your_github_token_here_optional
GITHUB_API_BASE_URL=https://api.github.com

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=incident_knowledge_base
